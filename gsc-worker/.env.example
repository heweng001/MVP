# 阿里云询盘系统根地址（不要末尾斜杠）
INQUIRY_API_BASE="https://mvp.maoniux.com"

# 与阿里云 .env 中 GSC_WORKER_SECRET（或 CRON_SECRET）一致
GSC_WORKER_SECRET="change-me"

# 服务账号 JSON 文件路径（推荐）
GOOGLE_APPLICATION_CREDENTIALS="/opt/gsc-worker/secrets/sa.json"

# 或把整份 JSON 放进环境变量（二选一）
# GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'

# 统计窗口（天），可被站点配置覆盖
GSC_PERIOD_DAYS="28"

# 无目标词表时，按点击拉取的 Top 查询条数
GSC_TOP_QUERIES="50"

# 页面维度 Top 条数（有展示的页面）
GSC_TOP_PAGES="100"

# 站与站之间间隔毫秒，降低配额压力
GSC_SITE_DELAY_MS="800"
