[Unit]
Description=TikTok fetch worker for FormManager ERP
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/tiktok-worker
EnvironmentFile=/opt/tiktok-worker/.env
ExecStart=/usr/bin/node /opt/tiktok-worker/server.mjs
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
