generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Client {
  id           String    @id @default(cuid())
  name         String
  contactName  String    @default("")
  phone        String    @default("")
  address      String    @default("")
  notes        String    @default("")
  /// 由下属网站自动汇总：最早开始 / 最晚结束
  serviceStart DateTime?
  serviceEnd   DateTime?
  lastVisitAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sites        Site[]
}

/// 信息核对（可关联一个网站；一站至多一条）
model ClientPromo {
  id               String    @id @default(cuid())
  /// 可选关联网站；唯一，保证一站一条
  siteId           String?   @unique
  site             Site?     @relation(fields: [siteId], references: [id], onDelete: SetNull)
  /// 关键词列表（客户可见，一行一个；另页编辑）
  keywords         String    @default("")
  /// 关键词内部备注（仅后台）
  keywordsNote     String    @default("")
  /// 公司产品要点（客户可见，纯文本）
  productPoints    String    @default("")
  /// 产品要点内部备注（仅后台）
  productPointsNote String   @default("")
  /// 广告要点（客户可见，纯文本）
  adPoints         String    @default("")
  /// 广告要点内部备注（仅后台）
  adPointsNote     String    @default("")
  editToken        String?   @unique
  editTokenExpires DateTime?
  lastSubmittedBy  String    @default("")
  lastSubmittedAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  histories        ClientPromoHistory[]
}

/// 信息核对更新记录
model ClientPromoHistory {
  id          String      @id @default(cuid())
  promoId     String
  promo       ClientPromo @relation(fields: [promoId], references: [id], onDelete: Cascade)
  submittedBy String
  createdAt   DateTime    @default(now())

  @@index([promoId, createdAt])
}

model Site {
  id              String    @id @default(cuid())
  clientId        String
  client          Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  domain          String
  /// SEO型 | 展示型（页签/邮件门控；列表不展示）
  siteType        String    @default("展示型")
  /// 重点 | 正常 | 维护
  tier            String    @default("正常")
  startDate       DateTime?
  endDate         DateTime?
  siteKey         String    @unique
  productKeywords String    @default("")
  spamExtraWords  String    @default("")
  /// JSON 字符串数组：邮件隐藏字段 id，默认含 geo、journey
  mailHiddenFields String  @default("")
  /// WordPress 后台入口（wp-admin 或 wp-login.php）
  wpAdminUrl      String    @default("")
  wpUsername      String    @default("")
  /// AES-GCM 加密后的 WP 登录密码（AUTH_SECRET）
  wpPasswordEnc   String    @default("")
  enabled         Boolean   @default(true)
  /// GSC 属性 URL，如 sc-domain:example.com 或 https://www.example.com/
  gscPropertyUrl  String    @default("")
  /// 是否由新加坡 worker 同步 GSC
  gscSyncEnabled  Boolean   @default(false)
  gscLastSyncAt   DateTime?
  gscLastError    String    @default("")
  /// 近 period 天有展示的查询词条数（缓存）
  gscKeywordCount Int       @default(0)
  /// 近 period 天有展示的页面数（缓存）
  gscPageCount    Int       @default(0)
  /// 近 period 天平均排名（缓存，越低越好）
  gscAvgPosition  Float?
  /// 同步使用的统计天数
  gscPeriodDays   Int       @default(28)
  /// GA4 媒体资源数字 ID（非 G-XXXX）
  gaPropertyId    String    @default("")
  /// 是否由新加坡 seo-worker 同步 GA4
  gaSyncEnabled   Boolean   @default(false)
  gaLastSyncAt    DateTime?
  gaLastError     String    @default("")
  gaPeriodDays    Int       @default(28)
  /// 近 period 天会话数（缓存）
  gaSessions      Int       @default(0)
  /// 近 period 天用户数（缓存）
  gaUsers         Int       @default(0)
  /// 近 period 天页面浏览量 screenPageViews（缓存）
  gaPageViews     Int       @default(0)
  /// 近 period 天互动会话数（缓存）
  gaEngagedSessions Int     @default(0)
  /// 近 period 天转化次数（关键事件，缓存）
  gaConversions   Int       @default(0)
  /// 近 period 天互动率 0～1（缓存）
  gaEngagementRate Float?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  forms           FormMailConfig[]
  inquiries       Inquiry[]
  blacklist       BlacklistEntry[]
  promo           ClientPromo?
  gscKeywords     SiteGscKeyword[]
  gscPages        SiteGscPage[]
  gaLandingPages  SiteGaLandingPage[]
  gaChannels      SiteGaChannel[]
  monthlyReports  SiteMonthlyReport[]
  monthSeoSnapshots SiteMonthSeoSnapshot[]

  @@index([clientId])
  @@index([siteType])
  @@index([tier])
  @@index([domain])
  @@index([gscSyncEnabled])
  @@index([gaSyncEnabled])
}

/// 按自然月冻结的 GSC/GA 数据（供月报与询盘同口径）
model SiteMonthSeoSnapshot {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  year      Int
  month     Int
  startDate String   @default("")
  endDate   String   @default("")
  /// JSON：keywords / pages / summary
  gscJson   String   @default("")
  /// JSON：summary / landingPages / channels
  gaJson    String   @default("")
  gscError  String   @default("")
  gaError   String   @default("")
  syncedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([siteId, year, month])
  @@index([siteId, year, month])
}

/// 网站月度报表快照（询盘自然月 + 同月 GSC/GA）
model SiteMonthlyReport {
  id          String   @id @default(cuid())
  siteId      String
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  year        Int
  month       Int
  viewToken   String   @unique
  /// JSON：KPI / Top 明细 / highlights / prev 环比等
  payload     String
  workDone    String   @default("")
  nextPlan    String   @default("")
  generatedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([siteId, year, month])
  @@index([siteId, year, month])
}

/// GSC 关键词表现缓存（由新加坡 worker 回写）
model SiteGscKeyword {
  id          String   @id @default(cuid())
  siteId      String
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  keyword     String
  position    Float    @default(0)
  clicks      Int      @default(0)
  impressions Int      @default(0)
  ctr         Float    @default(0)
  periodDays  Int      @default(28)
  syncedAt    DateTime @default(now())

  @@unique([siteId, keyword])
  @@index([siteId, position])
  @@index([siteId, clicks])
}

/// GSC 页面表现缓存（有展示≈可被搜到；非完整索引库）
model SiteGscPage {
  id          String   @id @default(cuid())
  siteId      String
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  pageUrl     String
  position    Float    @default(0)
  clicks      Int      @default(0)
  impressions Int      @default(0)
  ctr         Float    @default(0)
  periodDays  Int      @default(28)
  syncedAt    DateTime @default(now())

  @@unique([siteId, pageUrl])
  @@index([siteId, clicks])
}

/// GA4 落地页缓存（由新加坡 seo-worker 回写）
model SiteGaLandingPage {
  id               String   @id @default(cuid())
  siteId           String
  site             Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  pagePath         String
  sessions         Int      @default(0)
  engagedSessions  Int      @default(0)
  conversions      Int      @default(0)
  engagementRate   Float    @default(0)
  periodDays       Int      @default(28)
  syncedAt         DateTime @default(now())

  @@unique([siteId, pagePath])
  @@index([siteId, sessions])
}

/// GA4 默认渠道组缓存
model SiteGaChannel {
  id               String   @id @default(cuid())
  siteId           String
  site             Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  channelGroup     String
  sessions         Int      @default(0)
  engagedSessions  Int      @default(0)
  conversions      Int      @default(0)
  engagementRate   Float    @default(0)
  periodDays       Int      @default(28)
  syncedAt         DateTime @default(now())

  @@unique([siteId, channelGroup])
  @@index([siteId, sessions])
}

model FormMailConfig {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  formId    String
  label     String   @default("")
  toEmails  String
  ccEmails  String   @default("")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([siteId, formId])
}

model Inquiry {
  id              String    @id @default(cuid())
  siteId          String
  site            Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  formId          String
  entryId         String
  status          String    @default("pending")
  name            String    @default("")
  email           String    @default("")
  phone           String    @default("")
  subject         String    @default("")
  message         String    @default("")
  pageUrl         String    @default("")
  rawPayload      String    @default("{}")
  spamScore       Int       @default(0)
  spamHits        String    @default("[]")
  markToken       String    @unique
  submittedAt     DateTime  @default(now())
  reviewEnteredAt DateTime?
  sentAt          DateTime?
  /// 标记有效后发出的「可回复买家」第二封邮件时间
  followupSentAt  DateTime?
  markedAt        DateTime?
  /// 客户标记时选填的反馈原因
  markReason      String    @default("")
  notes           String    @default("")
  degraded        Boolean   @default(false)
  autoSentReview  Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([siteId, formId, entryId])
  @@index([status])
  @@index([submittedAt])
  @@index([sentAt])
}

model BlacklistEntry {
  id        String   @id @default(cuid())
  siteId    String?
  site      Site?    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  type      String
  value     String
  reason    String   @default("")
  createdAt DateTime @default(now())

  @@unique([type, value, siteId])
  @@index([type, value])
}

model AppSetting {
  id    String @id @default("default")
  value String @default("{}")
}
