DATABASE_URL="file:./dev.db"
APP_URL="http://localhost:3001"
AUTH_SECRET="change-me-to-a-long-random-string"
CRON_SECRET="change-me-cron-secret"
# 新加坡 seo-worker（GSC+GA）密钥（不填则回退使用 CRON_SECRET）
SEO_WORKER_SECRET="change-me-seo-worker-secret"
# 兼容旧名（可选）
GSC_WORKER_SECRET="change-me-gsc-worker-secret"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"
# AUTH_SECRET 同时用于加密站点 WP 后台密码；变更后需重新保存已存密码

# 月报 AI 草稿（DeepSeek，OpenAI 兼容接口）；不配则「AI 生成」按钮会提示未配置
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"

# 发件优先用后台「发件设置」；以下为未在后台保存时的回退
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="询盘系统 <noreply@your-domain.com>"

SPAM_THRESHOLD="80"
REVIEW_SCORE_MIN="20"
MARK_HOURS="72"
# 上述垃圾分阈值也可在后台「发件设置」中覆盖保存；未保存时使用此处默认值
