# 复制为服务器上的 .env.production 后修改
APP_URL="https://inquiry.your-domain.com"
AUTH_SECRET="请改成一长串随机字符"
CRON_SECRET="请改成一长串随机字符"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="请改成强密码"

# SQLite 路径由 docker-compose 注入，一般不必改
DATABASE_URL="file:/app/data/prod.db"

SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="询盘系统 <noreply@your-domain.com>"

SPAM_THRESHOLD="80"
REVIEW_HOURS="6"
MARK_HOURS="72"

HOST_PORT=3000
