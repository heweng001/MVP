# 阿里云询盘系统根地址（不要末尾斜杠）
INQUIRY_API_BASE="https://mvp.maoniux.com"

# 与阿里云 .env 中 SEO_WORKER_SECRET / GSC_WORKER_SECRET / CRON_SECRET 一致
SEO_WORKER_SECRET="change-me"

# 服务账号 JSON（需同时具备 GSC 只读 + GA4 查看者）
GOOGLE_APPLICATION_CREDENTIALS="/opt/seo-worker/secrets/sa.json"

# 或把整份 JSON 放进环境变量（二选一）
# GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'

# 默认统计窗口（天），可被站点配置覆盖
GSC_PERIOD_DAYS="28"
GA_PERIOD_DAYS="28"

# GSC：入库详情保留的点击 Top 条数（表格用）
GSC_TOP_QUERIES="500"
GSC_TOP_PAGES="500"
# GSC：漏斗统计分页拉取上限（尽量拉全；API 单次最多 25000，会自动翻页）
GSC_MAX_QUERIES="25000"
GSC_MAX_PAGES="25000"

# GA4：落地页 / 渠道 / 国家 Top 条数
GA_TOP_LANDING="100"
GA_TOP_CHANNELS="20"
GA_TOP_COUNTRIES="25"

# 站与站之间间隔毫秒
SEO_SITE_DELAY_MS="800"
